# AttackGraph AI Environment Variables Configuration
# Copy this file to .env and provide your API keys.

# API Authentication (Required for all routes except /health)
ATTACKGRAPH_API_KEY=your_attackgraph_api_key_here

# CORS Allowed Origins (Comma-separated, strictly no wildcards)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google Gemini API Key for autonomous LLM investigation loop
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model override (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Database Connection URL (Postgres container is bound strictly to 127.0.0.1:5432)
DATABASE_URL=postgresql://attackgraph_user:attackgraph_password@127.0.0.1:5432/attackgraph_db

# OWASP crAPI Lab Configuration
CRAPI_BASE_URL=http://localhost:8888
CRAPI_USER_A_EMAIL=
CRAPI_USER_A_TOKEN=
CRAPI_USER_B_EMAIL=
CRAPI_USER_B_TOKEN=
CRAPI_USER_B_VEHICLE_ID=
